    <h3>Clock</h3>${seg("clock", [["big","Big"],["small","Small"],["side","Left"],["none","Hidden"]])}
    <h3>Clock weight</h3>${seg("cweight", [[200,"Thin"],[300,"Light"],[400,"Regular"],[600,"Bold"]])}
    ${tog("h24","24-hour clock")}${tog("labels","Show app names")}${tog("showSearch","Show search bar")}${tog("showDock","Show dock")}
    ${tog("mask","Apply icon shape to real app icons")}${tog("plate","White plate behind real app icons")}
    ${tog("glass","Frosted glass effect")}${S.glass ? rng("blurPx","Glass blur",4,34,"px") : ""}`;
  } else if(tab === "wall"){
    h = `<h3>Wallpapers</h3><div class="wgrid">
      <button class="wp ${S.wall === "theme" && !S.wallImg ? "on" : ""}" style="background:${theme().wall}" data-act="wall" data-v="theme" aria-label="Theme wallpaper"></button>
      ${WALLS.map(w => `<button class="wp ${S.wall === w[0] && !S.wallImg ? "on" : ""}" style="background:${w[1]}" data-act="wall" data-v="${esc(w[0])}" aria-label="${esc(w[0])}"></button>`).join("")}</div>
    <h3>Your photo</h3><label class="btn alt" style="cursor:pointer">Choose from gallery<input type="file" accept="image/*" data-act="photo" hidden></label>
    ${S.wallImg ? `<button class="btn alt" data-act="nophoto">Remove photo</button>` : ""}
    ${rng("dim","Dim wallpaper",0,70,"%")}${rng("blur","Blur wallpaper",0,14,"px")}`;
  } else if(tab === "widgets"){
    const total = S.pages.length;
    h = `<h3>Home pages</h3><p class="hint" style="margin:0 0 8px">You have ${total} home ${total === 1 ? "page" : "pages"}. Swipe left or right on the home screen to move between them.</p>
    <button class="btn" data-act="addPage" ${total >= 5 ? "disabled" : ""}>Add a page</button><button class="btn alt" data-act="delPage" ${total <= 1 ? "disabled" : ""}>Remove last page</button>
    <h3>Widget page (swipe right from Home)</h3>
    ${tog("widgets","Show widget page")}${tog("wNotes","Quick notes")}${tog("wCal","Calendar")}${tog("wBat","Battery")}`;
  } else if(tab === "apps"){
    const list = allApps().slice().sort((a, b) => nameOf(a).localeCompare(nameOf(b)));
    h = `<h3>All apps (${list.length})</h3><div class="alist">${list.map(a => {
      const onH = S.pages.some(p => p.includes(a.id)), hid = S.hidden.includes(a.id);
      return `<div class="it">${icon(a)}<div class="nm">${esc(nameOf(a))}<small>${esc(a.native ? a.pkg : (a.target === "internal:themes" ? "Launcher themes" : a.target))}</small></div>
        <button class="mini ${onH ? "on" : ""}" data-act="${onH ? "unhomeA" : "homeA"}" data-v="${esc(a.id)}">${onH ? "On home" : "Add"}</button>
        <button class="mini ${hid ? "on" : ""}" data-act="${hid ? "unhide" : "hide"}" data-v="${esc(a.id)}">${hid ? "Hidden" : "Hide"}</button></div>`; }).join("")}</div>
    <h3>Add a shortcut</h3><div class="form">
      <input type="text" id="nName" placeholder="Name, for example Odnil Movies" autocomplete="off">
      <input type="text" id="nLink" placeholder="Website, or app package like com.spotify.music" autocomplete="off" autocapitalize="off">
      <div class="swatches"><span>Colour</span><input type="color" id="nColor" value="#3E91FF"></div>
      <button class="btn" data-act="addApp">Add shortcut</button></div>`;
  } else {
    h = `<h3>Gestures</h3>${tog("swipeDown","Swipe down on Home to search apps")}
    <h3>App drawer order</h3>${seg("sort", [["az","A to Z"],["used","Most used"]])}
    <h3>Home app</h3>
    <button class="btn" data-act="setDefault">Set as default home app</button><button class="btn alt" data-act="refresh">Refresh app list</button>
    <p class="hint">${NATIVE_ON ? "Choose Odnil Launcher in the list that opens, then pick Always." : "Setting the default home app and listing real apps only work in the installed APK."}</p>
    <h3>Backup</h3>
    <button class="btn alt" data-act="backup">Copy my settings</button><button class="btn alt" data-act="restore">Paste settings</button>
    <h3>Reset</h3><button class="btn alt" data-act="reset">Reset launcher</button>`;
  }
  const keep = $("#sbody").scrollTop;
  $("#sbody").innerHTML = h; $("#sbody").scrollTop = tab === sheetTab ? keep : 0; sheetTab = tab;
}

document.addEventListener("click", e => {
  const b = e.target.closest("[data-act]"); if(!b || !$("#sheet").contains(b)) return;
  const a = b.dataset.act, v = b.dataset.v, k = b.dataset.k;
  if(a === "closeSheet"){ closeSheet(); return; }
  if(a === "tab"){ tab = v; renderSheet(); return; }
  if(a === "theme"){ S.theme = v; S.wall = "theme"; S.wallImg = ""; }
  else if(a === "accent"){ S.accent = v; }
  else if(a === "set"){ S[k] = NUMKEYS.has(k) ? +v : v; }
  else if(a === "wall"){ S.wall = v; S.wallImg = ""; }
  else if(a === "nophoto"){ S.wallImg = ""; }
  else if(a === "homeA"){ const pg = S.pages[curHomePage()]; if(!pg.includes(v)) pg.push(v); }
  else if(a === "unhomeA"){ S.pages = S.pages.map(p => p.filter(x => x !== v)); }
  else if(a === "hide"){ if(!S.hidden.includes(v)) S.hidden.push(v); }
  else if(a === "unhide"){ S.hidden = S.hidden.filter(x => x !== v); }
  else if(a === "addPage"){ if(S.pages.length < 5) S.pages.push([]); }
  else if(a === "delPage"){ if(S.pages.length > 1 && (!S.pages[S.pages.length - 1].length || confirm("The last page has apps on it. Remove it anyway?"))) S.pages.pop(); }
  else if(a === "addApp"){
    const name = $("#nName").value.trim(), link = normalizeTarget($("#nLink").value);
    if(!name || !link){ toast("Enter a name and a link first"); return; }
    const id = "c" + Date.now();
    S.apps.push({id, name, icon:"", color:$("#nColor").value, target:link, custom:true}); S.pages[curHomePage()].push(id);
    toast(name + " added to Home");
  }
  else if(a === "setDefault"){ if(LP) LP.homeSettings().catch(() => toast("Open Settings > Apps > Default apps > Home app")); else toast("Install the APK first, then set it as default"); return; }
  else if(a === "refresh"){ if(LP) loadNative(false); else toast("Only works in the installed APK"); return; }
  else if(a === "backup"){
    const copy = Object.assign({}, S, {wallImg:""});
    (navigator.clipboard ? navigator.clipboard.writeText(JSON.stringify(copy)) : Promise.reject()).then(() => toast("Settings copied. Paste them somewhere safe."), () => toast("Could not copy"));
    return;
  }
  else if(a === "restore"){
    const t = prompt("Paste your copied settings here");
    if(!t) return;
    try{ const o = JSON.parse(t); if(typeof o !== "object" || !o.pages) throw 0; S = Object.assign(defaults(), o); toast("Settings restored"); }
    catch(err){ toast("That does not look like saved settings"); return; }
  }
  else if(a === "reset"){
    if(!confirm("Reset all launcher settings and apps?")) return;
    S = Object.assign(defaults(), {apps:clone(DEFAULT_APPS), pages:[DEF_HOME.slice()], dock:DEF_DOCK.slice()});
    autoLayout();
  }
  else return;
  save(); apply(); renderSheet();
});
document.addEventListener("input", e => {
  const b = e.target;
  if(b.id === "nt"){ S.notes = b.value; clearTimeout(input.h); input.h = setTimeout(save, 400); return; }
  if(!$("#sheet").contains(b)) return;
  if(b.dataset.act === "rng"){ S[b.dataset.k] = +b.value; $("#v_" + b.dataset.k).textContent = b.value + b.dataset.u; save(); apply(); }
});
const input = {h:0};
document.addEventListener("change", e => {
  const b = e.target; if(!$("#sheet").contains(b)) return;
  const a = b.dataset.act;
  if(a === "tog"){ S[b.dataset.k] = b.checked; save(); apply(); renderSheet(); }
  if(a === "accentPick"){ S.accent = b.value; save(); apply(); renderSheet(); }
  if(a === "photo" && b.files[0]) readPhoto(b.files[0]);
});
function readPhoto(file){
  const r = new FileReader();
  r.onload = () => {
    const img = new Image();
    img.onload = () => {
      const max = 1280, sc = Math.min(1, max / Math.max(img.width, img.height));
      const c = document.createElement("canvas"); c.width = Math.round(img.width * sc); c.height = Math.round(img.height * sc);
      c.getContext("2d").drawImage(img, 0, 0, c.width, c.height);
      S.wallImg = c.toDataURL("image/jpeg", .8); save(); apply(); renderSheet();
    };
    img.onerror = () => toast("That photo could not be opened");
    img.src = r.result;
  };
  r.readAsDataURL(file);
}

apply();
</script>
