    <h3>Accent colour</h3><div class="swatches">${ACCENTS.map(c => `<button class="sw-c ${S.accent === c ? "on" : ""}" style="background:${c}" data-act="accent" data-v="${c}" aria-label="Accent ${c}"></button>`).join("")}<input type="color" value="${S.accent}" data-act="accentPick" aria-label="Custom accent colour"></div>
    ${tog("auto","Switch to a dark theme at night")}
    ${S.auto ? `<h3>Night theme (7 pm to 6 am)</h3>${seg("night", [["dark","One UI Dark"],["amoled","AMOLED"],["forest","Forest"]])}` : ""}
